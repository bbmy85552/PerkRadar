# PostgreSQL connection string. Required at runtime.
# Example: postgres://USER:PASSWORD@HOST:5432/perkradar
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/perkradar

# Shared secret for external refresh triggers (cron, GitHub Actions, Vercel Cron).
# Send as `Authorization: Bearer <secret>` or `X-Cron-Secret` / `X-Refresh-Secret`.
# If this is set, unauthenticated refresh from the public internet is rejected.
CRON_SECRET=replace-with-a-long-random-string

# Optional alias for CRON_SECRET. Used only when CRON_SECRET is empty.
# REFRESH_SECRET=

# Opt in to the in-process scheduler (boot + every 2 hours). Off by default.
# Do not enable this on Vercel, Docker production, or any public deployment.
# ENABLE_SCHEDULER=1

# Hard-disable the in-process scheduler even if ENABLE_SCHEDULER=1.
# DISABLE_SCHEDULER=1
